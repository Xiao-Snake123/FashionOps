# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 环境变量（含数据库密码，绝不入库）----
.env
.env.*
# 模板文件是例外：里面只有占位符，是"照着填"的起点。
# 少了这两行，`.env.*` 会把它们一起挡掉 —— 而表现是
# "文档里让你复制这个文件，但仓库里根本没有"。
!.env.example
!.env.docker.example
!.env.*.example

# ---- 本地数据（MySQL 之外的所有运行时产物）----
data/
logs/

# ---- 前端 ----
node_modules/
frontend/dist/
frontend/.vite/

# ---- IDE ----
.vscode/
.idea/
