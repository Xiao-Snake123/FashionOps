# ============================================================================
# 服装电商多 Agent 运营中台 —— 配置模板
# ============================================================================
# 用法：复制成 .env 后按需修改。或者直接跑 deploy/scripts/init-mysql.ps1
#       让脚本自动填好数据库那几项。
#
# 【重要】.env 里有数据库密码，已在 .gitignore 里排除，不要提交。
# ============================================================================

# ---------------------------------------------------------------------------
# 基础
# ---------------------------------------------------------------------------
FASHIONOPS_ENV=dev
FASHIONOPS_TIMEZONE=Asia/Shanghai
# 本地数据根目录：素材、报表、checkpoint、日志都落在这下面
FASHIONOPS_DATA_DIR=./data

# ---------------------------------------------------------------------------
# 关系库：MySQL 8.0
# ---------------------------------------------------------------------------
# 留空 FASHIONOPS_DB_HOST 就会退回到 SQLite 文件（跑单测用，不依赖 MySQL）。
# 正常开发请填 127.0.0.1 并跑 init-mysql.ps1 自动填好下面几项。
FASHIONOPS_DB_HOST=
FASHIONOPS_DB_PORT=3306
FASHIONOPS_DB_USER=fashionops
FASHIONOPS_DB_PASSWORD=
FASHIONOPS_DB_NAME=fashionops
# 是否打印 SQL（排查慢查询时开）
FASHIONOPS_DB_ECHO=false
# 如需完全自己拼连接串，用它覆盖上面的分项配置
# FASHIONOPS_DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/fashionops?charset=utf8mb4

# ---------------------------------------------------------------------------
# 缓存 / 任务状态：Redis
# 用途：LangGraph 任务图 checkpoint、工具网关限流计数与熔断状态
# ---------------------------------------------------------------------------
FASHIONOPS_REDIS_URL=redis://127.0.0.1:6379/0
FASHIONOPS_REDIS_KEY_PREFIX=fashionops
# 缓存后端：redis（默认）/ sqlite（无 Redis 时降级）/ memory（单测用）
FASHIONOPS_CACHE_BACKEND=redis

# ---------------------------------------------------------------------------
# 向量库：Qdrant
# 用途：智能客服 RAG 的知识库检索
# ---------------------------------------------------------------------------
FASHIONOPS_QDRANT_URL=http://127.0.0.1:6333
# Qdrant 云服务才需要；本地实例留空
FASHIONOPS_QDRANT_API_KEY=
FASHIONOPS_VECTOR_BACKEND=qdrant
# 集合名：政策条款 / 历史工单 / 商品知识
FASHIONOPS_QDRANT_COLLECTION_KB=kb_articles
FASHIONOPS_QDRANT_COLLECTION_TICKETS=ticket_history
# 向量维度，必须和 embedding 模型一致（bge-m3 是 1024）
FASHIONOPS_EMBEDDING_DIM=1024

# ---------------------------------------------------------------------------
# 对象存储：本地文件系统（将来可切 MinIO）
# ---------------------------------------------------------------------------
FASHIONOPS_STORAGE_BACKEND=local
FASHIONOPS_STORAGE_DIR=./data/storage

# ---------------------------------------------------------------------------
# 模型
# ---------------------------------------------------------------------------
# mock = 零 API Key 跑通全链路（返回结构合法的假响应）
# 真实模型：deepseek / qwen / zhipu / openai
#
# 接真实模型只改两行：
#   FASHIONOPS_MODEL_PROVIDER=deepseek
#   FASHIONOPS_MODEL_API_KEY=sk-xxxxxxxx
#
# 各家 base_url 会自动选，不用手填（要覆盖再用 FASHIONOPS_MODEL_BASE_URL）：
#   deepseek -> https://api.deepseek.com/v1
#   qwen     -> https://dashscope.aliyuncs.com/compatible-mode/v1
#   zhipu    -> https://open.bigmodel.cn/api/paas/v4
#   openai   -> SDK 默认
#
# 【重要】改完 .env 后正在跑的进程不会自动重载（uvicorn 要用 --reload），
#         建议先跑一遍自检确认真的通：
#             uv run python scripts/check_model.py
# ---------------------------------------------------------------------------
FASHIONOPS_MODEL_PROVIDER=mock
# 这一行含密钥，.env 已被 .gitignore 排除，不要提交
FASHIONOPS_MODEL_API_KEY=
FASHIONOPS_MODEL_BASE_URL=
# 主力模型名（必须和 provider 匹配：deepseek 用 deepseek-chat、qwen 用 qwen-plus…）
FASHIONOPS_MODEL_NAME=deepseek-chat
# 轻量模型：用于模型路由，简单任务（分类/抽取/格式化）走它，降本
FASHIONOPS_MODEL_NAME_FAST=deepseek-chat
FASHIONOPS_MODEL_TEMPERATURE=0.3

# 额外需要绕过系统代理的地址（逗号分隔）。回环地址已自动加入，
# 这里填内网域名。如果你用了代理才能访问模型 API，**不要**把模型域名写进来。
# FASHIONOPS_NO_PROXY_EXTRA=

# ---------------------------------------------------------------------------
# 外部系统接入（全部 Mock 占位，开发期不发真实请求）
# ---------------------------------------------------------------------------
FASHIONOPS_ECOM_API_MODE=mock
FASHIONOPS_AD_API_MODE=mock
FASHIONOPS_ERP_API_MODE=mock

# ---------------------------------------------------------------------------
# 工具网关：限流 / 重试 / 熔断
# ---------------------------------------------------------------------------
FASHIONOPS_GATEWAY_RATE_LIMIT_PER_MINUTE=120
FASHIONOPS_GATEWAY_MAX_RETRIES=2
FASHIONOPS_GATEWAY_CIRCUIT_BREAKER_THRESHOLD=5
FASHIONOPS_GATEWAY_CIRCUIT_BREAKER_COOLDOWN=60

# ---------------------------------------------------------------------------
# 邮件通知 Agent —— 四层发送闸门
# ---------------------------------------------------------------------------
# 【安全设计】这四个默认值都是"更安全的那个"：
#   总开关关着、dry_run 开着、白名单为空（空 = 禁止发送任何邮件）。
# 漏配的后果是"发不出去"，而不是"能发给任何人"。
#
# 推荐的使用顺序：
#   1. 先保持现状（enabled=false）跑通全流程，邮件会被记录但发不出去
#   2. 打开总开关 + 白名单，still dry_run=true —— 验证策略是否符合预期
#   3. 最后才配 SMTP 并把 dry_run 关掉
FASHIONOPS_MAIL_ENABLED=false
FASHIONOPS_MAIL_DRY_RUN=true
FASHIONOPS_MAIL_FROM=agent@fashionops.local

# 收件人白名单，逗号分隔。支持三种写法：* （全部）/ @corp.com（整个域）/ a@b.com（精确）
FASHIONOPS_MAIL_SEND_ALLOWLIST=
# 收件人黑名单，优先级高于白名单
FASHIONOPS_MAIL_SEND_DENYLIST=
FASHIONOPS_MAIL_MAX_RECIPIENTS=10
# 每个收件人每分钟最多收几封。防模型陷入循环把同一封信重复发几十遍
FASHIONOPS_MAIL_RATE_LIMIT_PER_MINUTE=6
FASHIONOPS_MAIL_MAX_ATTACHMENT_BYTES=20971520
FASHIONOPS_MAIL_ATTACHMENT_ALLOWLIST=.xlsx,.pdf,.csv,.png,.jpg,.jpeg

# SMTP：只在真的要投递时用。开发期 dry_run=true 时完全用不到。
# 【注意】port 465 配 smtp_use_ssl=true；587 配 false（走 STARTTLS）
# 【注意】password 填邮箱服务商生成的 **授权码**，不是邮箱登录密码
FASHIONOPS_SMTP_HOST=
FASHIONOPS_SMTP_PORT=465
FASHIONOPS_SMTP_USER=
FASHIONOPS_SMTP_PASSWORD=
FASHIONOPS_SMTP_USE_SSL=true
FASHIONOPS_SMTP_TIMEOUT=20

# ---------------------------------------------------------------------------
# 可观测性（阶段 3 打开）
# ---------------------------------------------------------------------------
FASHIONOPS_OTEL_ENABLED=false
FASHIONOPS_OTEL_ENDPOINT=
FASHIONOPS_OTEL_SERVICE_NAME=fashionops
