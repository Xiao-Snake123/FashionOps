# 复制为 .env 后按需修改。所有变量都带 OFFICE_MCP_ 前缀。

# ---- 工作区（所有文件操作的沙箱边界）----
OFFICE_MCP_WORKSPACE_ROOT=./workspace

# ---- 审计日志（JSONL，留空则关闭）----
OFFICE_MCP_AUDIT_LOG=./workspace/audit.jsonl

# ---- 运行模式 ----
# 1 = 只返回将要执行的动作，不产生任何副作用（不发邮件、不写日历）
OFFICE_MCP_DRY_RUN=0
# 单文件读取上限（字节），默认 8 MB
OFFICE_MCP_MAX_READ_BYTES=8388608
# 日志级别
OFFICE_MCP_LOG_LEVEL=INFO
# 传输方式：stdio（默认）| http
OFFICE_MCP_TRANSPORT=stdio
# HTTP 模式下的监听地址
OFFICE_MCP_HOST=127.0.0.1
OFFICE_MCP_PORT=8765

# ---- 邮件（可选，未配置时邮件工具返回 upstream_unavailable）----
# OFFICE_MCP_SMTP_HOST=smtp.example.com
# OFFICE_MCP_SMTP_PORT=465
# OFFICE_MCP_SMTP_USE_SSL=true
# OFFICE_MCP_IMAP_HOST=imap.example.com
# OFFICE_MCP_IMAP_PORT=993
# OFFICE_MCP_IMAP_USE_SSL=true
# OFFICE_MCP_MAIL_ADDRESS=me@example.com
# OFFICE_MCP_MAIL_PASSWORD=changeme

# ---- 邮件发送闸门（重要：不配白名单就发不出任何邮件）----
# 允许发送的收件人，支持 @域名（整个域）或完整地址；留空 = 禁止发送
# OFFICE_MCP_MAIL_SEND_ALLOWLIST=["@corp.example.com"]
# 黑名单，优先级高于白名单
# OFFICE_MCP_MAIL_SEND_DENYLIST=["ceo@corp.example.com"]
# 单封邮件收件人上限
# OFFICE_MCP_MAIL_MAX_RECIPIENTS=10
# 每分钟发送条数上限（防止模型循环发信）
# OFFICE_MCP_MAIL_RATE_LIMIT_PER_MINUTE=5
# 单个附件大小上限（字节），默认 10 MB
# OFFICE_MCP_MAIL_MAX_ATTACHMENT_BYTES=10485760
# 允许作为附件外发的扩展名
# OFFICE_MCP_MAIL_ATTACHMENT_ALLOWLIST=[".pdf", ".docx", ".xlsx", ".pptx", ".md", ".txt", ".csv", ".png", ".jpg"]
# 发送成功后是否存档到「已发送」
# OFFICE_MCP_MAIL_SAVE_SENT_COPY=true
# OFFICE_MCP_MAIL_SENT_FOLDER=Sent
# 读取邮件正文时的截断长度
# OFFICE_MCP_IMAP_MAX_BODY_CHARS=20000

# ---- 日历（可选）----
# OFFICE_MCP_CALDAV_URL=https://caldav.example.com
# OFFICE_MCP_CALDAV_USERNAME=me
# OFFICE_MCP_CALDAV_PASSWORD=changeme
OFFICE_MCP_TIMEZONE=Asia/Shanghai

# ---- 通用密钥（供自研 MCP server 使用）----
# 命名约定：OFFICE_MCP_SECRET_<NAME>
# OFFICE_MCP_SECRET_OA_TOKEN=changeme
